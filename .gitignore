*.pac
*.sa


# Generated workflow results
**/results/*

# Allow placeholder so results/ directory can exist in GitHub
!**/results/.gitkeep


# Raw data directories
**/data/raw/*

# Allow placeholder
!**/data/raw/.gitkeep


# Logs / temporary files
*.log
*.tmp
*.temp


# macOS
.DS_Store


# Python
__pycache__/
*.pyc


# Conda local environments
.conda/
conda-env/
